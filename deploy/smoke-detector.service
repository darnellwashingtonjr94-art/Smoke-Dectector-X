[Unit]
Description=Smoke-Detector-X Edge AI Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/Smoke-Detector-X/src
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=5

# Ensure hardware permissions
AmbientCapabilities=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
